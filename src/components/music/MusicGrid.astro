---
/** MusicGrid — first featured release spans 2 columns on desktop (editorial rhythm). */
import type { Release } from "@/types/content";
import MusicCard from "./MusicCard.astro";

interface Props {
  releases: Release[];
}
const { releases } = Astro.props;
---

<div class="mg">
  {releases.map((r, i) => <MusicCard release={r} feature={i === 0 && releases.length > 2} />)}
</div>

<style>
  .mg {
    display: grid;
    gap: var(--space-10) var(--space-6);
    grid-template-columns: 1fr;
  }
  @media (min-width: 480px) {
    .mg {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .mg {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .mg > :global(.mc--feature) {
      grid-column: span 2;
      grid-row: span 2;
    }
  }
</style>
