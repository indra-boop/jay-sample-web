---
/**
 * MixRow — one mix in an editorial list. Press Play → official provider widget loads inline
 * (click-to-load: no third-party request or audio before the visitor asks). Press again → closes
 * and stops audio. Opening another mix closes the current one.
 */
import { embedLabel } from "@/lib/platforms";
import type { LiveSet } from "@/types/content";

interface Props {
  set: LiveSet;
  index: number;
}
const { set, index } = Astro.props;
const playerId = `player-${set.id}`;
const height = set.provider === "mixcloud" ? 120 : 166;
---

<li class="mix reveal">
  <div class="mix__row">
    <span class="mix__no meta" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
    <div class="mix__what">
      <h3 class="mix__title display">{set.title}</h3>
      <p class="mix__meta meta">
        {embedLabel[set.provider]}{set.duration && <> · <span class="mix__dur">{set.duration}</span></>}
        {set.venue && <> · {set.venue}</>}
      </p>
    </div>
    <div class="mix__actions">
      <button
        type="button"
        class="mix__play"
        data-embed-src={set.embedUrl}
        data-embed-url={set.url}
        data-embed-title={`${set.title} — ${embedLabel[set.provider]} player`}
        data-embed-target={playerId}
        data-embed-height={height}
        aria-expanded="false"
        aria-controls={playerId}
      >
        <span class="mix__icon" aria-hidden="true"></span>
        <span class="mix__label" data-label-play="Listen" data-label-close="Close">Listen</span>
        <span class="visually-hidden">: {set.title}</span>
      </button>
      <a class="mix__ext meta" href={set.url} target="_blank" rel="noopener noreferrer">
        {embedLabel[set.provider]} ↗<span class="visually-hidden">: {set.title} (opens in a new tab)</span>
      </a>
    </div>
  </div>
  <div class="mix__player" id={playerId} hidden></div>
</li>

<style>
  .mix {
    border-top: 1px solid var(--border-strong);
  }
  .mix:last-child {
    border-bottom: 1px solid var(--border-strong);
  }
  .mix__row {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    grid-template-areas:
      "no what"
      "actions actions";
    gap: var(--space-3) var(--space-4);
    padding-block: var(--space-5);
    align-items: center;
  }
  .mix__no {
    grid-area: no;
    align-self: start;
    padding-top: 0.35em;
    color: var(--foreground-subtle);
  }
  .mix__what {
    grid-area: what;
    min-width: 0;
  }
  .mix__title {
    font-size: var(--font-size-xl);
    line-height: var(--line-height-tight);
  }
  .mix__meta {
    margin-top: var(--space-1);
    color: var(--foreground-subtle);
  }
  .mix__dur {
    font-variant-numeric: tabular-nums;
  }
  .mix__actions {
    grid-area: actions;
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .mix__play {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--control-height);
    padding: 0 var(--space-5) 0 var(--space-2);
    border: 1px solid var(--border-input);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--foreground);
    font-size: var(--font-size-xs);
    font-stretch: var(--font-stretch-meta);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-button);
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      border-color var(--transition-fast);
  }
  .mix__play:hover {
    border-color: var(--metal-mid);
    background: var(--surface-hover);
  }
  .mix__play[aria-expanded="true"] {
    background: var(--action-primary);
    color: var(--action-primary-foreground);
    border-color: var(--action-primary);
  }
  .mix__icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-full);
    background: var(--action-primary);
  }
  .mix__icon::before {
    content: "";
    margin-left: 3px;
    border-style: solid;
    border-width: 6px 0 6px 10px;
    border-color: transparent transparent transparent var(--action-primary-foreground);
  }
  .mix__play[aria-expanded="true"] .mix__icon {
    background: var(--action-primary-foreground);
  }
  .mix__play[aria-expanded="true"] .mix__icon::before {
    margin: 0;
    width: 10px;
    height: 10px;
    border: 0;
    background: var(--action-primary);
  }
  .mix__ext {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    color: var(--foreground-muted);
    text-decoration: none;
  }
  .mix__ext:hover {
    color: var(--foreground);
    text-decoration: underline;
  }
  .mix__player {
    padding-bottom: var(--space-5);
  }
  .mix__player :global(iframe) {
    display: block;
    width: 100%;
    border: 0;
    background: var(--surface); /* no white flash while the widget loads */
  }

  @media (min-width: 768px) {
    .mix__row {
      grid-template-columns: 3rem minmax(0, 1fr) auto;
      grid-template-areas: "no what actions";
      gap: var(--space-6);
      padding-block: var(--space-6);
      transition: background-color var(--transition-normal);
    }
    .mix__row:hover {
      background: linear-gradient(90deg, transparent, var(--surface) 20%, var(--surface) 80%, transparent);
    }
    .mix__no {
      align-self: center;
      padding-top: 0;
    }
  }
</style>
