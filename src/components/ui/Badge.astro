---
/** Small uppercase label. `tone="status"` adds a leading glyph so meaning isn't colour-only. */
interface Props {
  tone?: "neutral" | "outline" | "muted";
  class?: string;
}
const { tone = "outline", class: className } = Astro.props;
---

<span class:list={["badge", `badge--${tone}`, className]}><slot /></span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-xs);
    font-size: var(--font-size-2xs);
    font-stretch: var(--font-stretch-meta);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    line-height: 1.3;
    white-space: nowrap;
  }
  .badge--outline {
    border: 1px solid var(--border-strong);
    color: var(--foreground-muted);
  }
  .badge--neutral {
    background: var(--foreground);
    color: var(--background);
  }
  .badge--muted {
    background: var(--surface-raised);
    color: var(--foreground-subtle);
  }
</style>
