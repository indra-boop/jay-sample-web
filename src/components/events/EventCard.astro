---
/** EventCard — compact card for dense listings (e.g. past events grid). */
import { eventDateParts } from "@/lib/format";
import type { ArtistEvent } from "@/types/content";

interface Props {
  event: ArtistEvent;
}
const { event } = Astro.props;
const d = eventDateParts(event.date);
---

<li class="ec reveal" data-event-date={event.date}>
  <time class="meta ec__date" datetime={event.date}>{d.day} {d.month} {d.year}</time>
  <h3 class="ec__title">{event.eventName ?? event.venue}</h3>
  {event.eventName && <p class="ec__venue">{event.venue}</p>}
  <p class="meta ec__where">{event.city}, {event.country}</p>
</li>

<style>
  .ec {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-5);
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .ec__date {
    color: var(--foreground-subtle);
  }
  .ec__title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-tight);
    overflow-wrap: anywhere;
  }
  .ec__venue {
    color: var(--foreground-muted);
  }
</style>
