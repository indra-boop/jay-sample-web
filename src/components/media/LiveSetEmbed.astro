---
/** LiveSetEmbed — click-to-load facade. No iframe, no audio until the visitor presses play. */
import { embedLabel } from "@/lib/platforms";
import type { LiveSet } from "@/types/content";
import { withBase } from "@/lib/url";

interface Props {
  set: LiveSet;
}
const { set } = Astro.props;
const tall = set.provider === "youtube" || set.provider === "vimeo";
---

<figure class="lse reveal">
  <div class:list={["lse__frame", tall ? "lse__frame--video" : "lse__frame--audio"]}>
    <button type="button" class="lse__play" data-embed-src={set.embedUrl} data-embed-title={`${set.title} — ${embedLabel[set.provider]} player`}>
      {set.poster && <img src={withBase(set.poster.src)} width={set.poster.width} height={set.poster.height} alt="" loading="lazy" decoding="async" />}
      <span class="lse__cta">
        <span class="lse__icon" aria-hidden="true">▶</span>
        <span class="meta">Play on {embedLabel[set.provider]}</span>
        <span class="visually-hidden">: {set.title}</span>
      </span>
    </button>
  </div>
  <figcaption class="lse__cap">
    <span class="display lse__title">{set.title}</span>
    {(set.venue || set.recordedAt) && <span class="meta">{[set.venue, set.recordedAt].filter(Boolean).join(" · ")}</span>}
    <a class="meta lse__ext" href={set.url} target="_blank" rel="noopener noreferrer">Open on {embedLabel[set.provider]}<span class="visually-hidden"> (opens in a new tab)</span></a>
  </figcaption>
</figure>

<script>
  import "@/client/embed";
</script>

<style>
  .lse {
    display: grid;
    gap: var(--space-4);
  }
  .lse__frame {
    position: relative;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .lse__frame--video {
    aspect-ratio: 16 / 9;
  }
  .lse__frame--audio {
    height: 180px;
  }
  .lse__frame :global(.embed__frame) {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .lse__play {
    position: absolute;
    inset: 0;
    width: 100%;
    padding: 0;
    border: 0;
    background: radial-gradient(60% 80% at 50% 50%, var(--surface-hover), var(--surface));
    cursor: pointer;
  }
  .lse__play img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
  }
  .lse__cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--foreground);
  }
  .lse__icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border: 1px solid var(--metal-mid);
    border-radius: var(--radius-full);
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }
  .lse__play:hover .lse__icon {
    background: var(--action-primary);
    color: var(--action-primary-foreground);
  }
  .lse__cap {
    display: grid;
    gap: var(--space-1);
  }
  .lse__title {
    font-size: var(--font-size-xl);
  }
  .lse__ext {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    width: fit-content;
  }
</style>
