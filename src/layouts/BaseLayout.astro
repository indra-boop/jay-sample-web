---
/**
 * BaseLayout — document shell, SEO head, landmarks.
 * preview mode → robots noindex (site must not be indexed with gap notices).
 */
import "@/styles/global.css";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import { site } from "@/data/site";
import { isPreview, siteUrl } from "@/lib/content-mode";
import { artistJsonLd, ldJson } from "@/lib/seo";
import { absoluteUrl, withBase } from "@/lib/url";
import fontUrl from "@/assets/fonts/archivo-latin-wdth-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  overlayHeader?: boolean;
  hiddenNav?: readonly string[];
  jsonLd?: unknown[];
  noindex?: boolean;
}
const { title, description = site.description, overlayHeader = false, hiddenNav = [], jsonLd = [], noindex = false } = Astro.props;
const fullTitle = title ? site.titleTemplate.replace("%s", title) : site.defaultTitle;
const canonical = siteUrl ? new URL(Astro.url.pathname, siteUrl).toString() : undefined;
const ogImage = siteUrl ? absoluteUrl(site.ogImage.src, siteUrl) : withBase(site.ogImage.src);
const robots = isPreview || noindex ? "noindex, nofollow" : "index, follow";
const structured = [artistJsonLd(siteUrl), ...jsonLd];
---

<!doctype html>
<html lang={site.locale} data-theme="jay-sample-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content={site.themeColor} />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href={withBase("/brand/icons/favicon-32.png")} sizes="32x32" type="image/png" />
    <link rel="icon" href={withBase("/brand/icons/favicon-48.png")} sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href={withBase("/brand/icons/apple-touch-icon.png")} />
    <link rel="manifest" href={withBase("/site.webmanifest")} />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(site.ogImage.width)} />
    <meta property="og:image:height" content={String(site.ogImage.height)} />
    <meta property="og:image:alt" content={site.ogImage.alt} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {structured.map((d) => <script type="application/ld+json" set:html={ldJson(d)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={overlayHeader} hidden={hiddenNav} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer hidden={hiddenNav} />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
